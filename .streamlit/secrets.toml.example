# Copy this file to .streamlit/secrets.toml and fill in your own key.
# .streamlit/secrets.toml is git-ignored — never commit the real key.
GROQ_API_KEY = "your-groq-api-key-here"

# Optional model overrides (defaults: openai/gpt-oss-120b text,
# meta-llama/llama-4-maverick-17b-128e-instruct vision)
# GROQ_TEXT_MODEL = "openai/gpt-oss-120b"
# GROQ_VISION_MODEL = "meta-llama/llama-4-maverick-17b-128e-instruct"
